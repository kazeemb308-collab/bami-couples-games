rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /coupleRooms/{roomId} {
      // Prototype protection: requires Firebase sign-in and a 6-character room code.
      // Before a public launch, add strict player-membership checks and validate game-state updates.
      allow read, write: if request.auth != null
        && roomId.matches('^[A-Z0-9]{6}$');
    }
  }
}